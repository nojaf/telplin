<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RollForward>Major</RollForward>
    <ToolCommandName>telplin</ToolCommandName>
    <PackAsTool>True</PackAsTool>
    <AssemblyName>telplin</AssemblyName>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
    <RootNamespace>Telplin</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Theme.fs" />
    <Compile Include="Arguments.fsi" />
    <Compile Include="Arguments.fs" />
    <Compile Include="HelpPage.fsi" />
    <Compile Include="HelpPage.fs" />
    <Compile Include="ProjectFile.fsi" />
    <Compile Include="ProjectFile.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telplin.Core\Telplin.Core.fsproj" />
  </ItemGroup>

</Project>
